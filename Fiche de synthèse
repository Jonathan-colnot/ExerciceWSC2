Chiffre d'affaire total :
SELECT SUM(c3 * c4)
FROM ventes;
= 44825

Ventes par produit :
SELECT 
    c2,
    c4
FROM ventes
GROUP BY c2
ORDER BY c2;
= Produit A : 100 / Produit B : 50 / Produit C : 30

Ventes par régions :
SELECT 
    c5,
    SUM(c4)
FROM ventes
GROUP BY c5
ORDER BY c5;
= Nord : 1605 / Sud : 1775
